// =======================================================================
// SiteForge Prisma Schema
// =======================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------
// User & Authentication
// -----------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  plan      Plan     @default(FREE)
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websites     Website[]
  subscription Subscription?
  aiJobs       AIJob[]

  @@index([clerkId])
  @@index([email])
}


// -----------------------------------------------------------------------
// Websites & Pages
// -----------------------------------------------------------------------

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Website {
  id           String        @id @default(cuid())
  userId       String
  name         String
  slug         String        @unique
  customDomain String?       @unique
  description  String?
  logoUrl      String?
  faviconUrl   String?
  config       Json          @default("{}")
  status       WebsiteStatus @default(DRAFT)
  templateId   String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])
  pages    Page[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Page {
  id          String   @id @default(cuid())
  websiteId   String
  title       String
  slug        String
  description String?
  components  Json     @default("[]")
  isHomepage  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId])
}

// -----------------------------------------------------------------------
// Templates
// -----------------------------------------------------------------------

enum TemplateCategory {
  RESTAURANT
  PORTFOLIO
  ECOMMERCE
  BLOG
  LANDING_PAGE
  AGENCY
  SAAS
  HEALTHCARE
  EDUCATION
  NONPROFIT
  REAL_ESTATE
  FITNESS
  OTHER
}

model Template {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  thumbnailUrl String
  previewUrl   String?
  category     TemplateCategory
  tags         String[]
  config       Json             @default("{}")
  pages        Json             @default("[]")
  isPremium    Boolean          @default(false)
  isActive     Boolean          @default(true)
  usageCount   Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  websites Website[]

  @@index([category])
  @@index([isActive])
}

// -----------------------------------------------------------------------
// Subscriptions & Payments
// -----------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

model Subscription {
  id                   String               @id @default(cuid())
  userId               String               @unique
  stripeCustomerId     String               @unique
  stripeSubscriptionId String?              @unique
  plan                 SubscriptionPlan     @default(FREE)
  interval             SubscriptionInterval @default(MONTHLY)
  status               PaymentStatus        @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

// -----------------------------------------------------------------------
// AI Jobs
// -----------------------------------------------------------------------

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIJobType {
  GENERATE_WEBSITE
  GENERATE_PAGE
  GENERATE_COMPONENT
  EDIT_CONTENT
  GENERATE_SEO
  GENERATE_COPY
}

model AIJob {
  id              String      @id @default(cuid())
  userId          String
  websiteId       String?
  type            AIJobType
  status          AIJobStatus @default(PENDING)
  prompt          String
  context         Json        @default("{}")
  result          Json?
  error           String?
  tokensUsed      Int         @default(0)
  processingTimeMs Int?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}
